# Copy this file to .env and fill in values from the Firebase console
# (Project settings → General → Your apps → SDK setup and configuration).
# .env is gitignored — never commit real keys.
#
# Firebase project must be created on the Spark (free) plan — see
# rules.md §2 and architecture.md §6. Enable Firestore and
# Authentication (Email/Password provider). Storage is not used —
# bill photo attachment was dropped from v1 scope; see architecture.md §6.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Master Admin login email (password is in Firebase Auth, never in this file).
# Vite embeds this in the client — it is an identifier, not a secret.
VITE_MASTER_ADMIN_EMAIL=imhelipatel12@gmail.com

# Legacy tenant id for the first company (Shreenathji Traders). Kept so
# existing Firestore + IndexedDB data keeps working.
VITE_BUSINESS_ID=shreenath-traders
