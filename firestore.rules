// Firestore security rules — multi-tenant (companies stored as `businesses`).
//
// Isolation:
//   - Each company's ledgers live under businesses/{companyId}/…
//   - Members only read/write their own company
//   - Master Admin (users/{uid}.role == master_admin) can manage every company
//   - Public signup cannot create a company (invite or one-time bootstrap only)
//
// Roles:
//   - master_admin: platform operator (companyId null)
//   - company_admin / owner (legacy): company books + staff
//   - staff: ledger write, no settings/users
//   - ca: read-only
//
// Financial rows (bills/payments/vepariPayments): soft-void only.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function authEmailLower() {
      return request.auth.token.email.lower();
    }

    function platformUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isMasterAdmin() {
      return isSignedIn() && (
        isDesignatedMasterEmail() ||
        (
          exists(platformUserPath()) &&
          get(platformUserPath()).data.role == 'master_admin' &&
          get(platformUserPath()).data.get('status', 'active') != 'disabled'
        )
      );
    }

    function userDoc(companyId) {
      return get(/databases/$(database)/documents/businesses/$(companyId)/users/$(request.auth.uid));
    }

    function role(companyId) {
      return userDoc(companyId).data.role;
    }

    function isMember(companyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/businesses/$(companyId)/users/$(request.auth.uid)) &&
        userDoc(companyId).data.get('status', 'active') != 'disabled';
    }

    function isCompanyAdmin(companyId) {
      return isMasterAdmin() ||
        (isMember(companyId) && role(companyId) in ['owner', 'company_admin']);
    }

    function isStaffOrOwner(companyId) {
      return isMasterAdmin() ||
        (isMember(companyId) && role(companyId) in ['owner', 'company_admin', 'staff']);
    }

    function companyExists(companyId) {
      return exists(/databases/$(database)/documents/businesses/$(companyId));
    }

    function companyData(companyId) {
      return get(/databases/$(database)/documents/businesses/$(companyId)).data;
    }

    function companyActive(companyId) {
      return isMasterAdmin() ||
        companyData(companyId).get('status', 'active') == 'active';
    }

    function companyNotDeleted(companyId) {
      return isMasterAdmin() ||
        companyData(companyId).get('status', 'active') != 'deleted';
    }

    function ownCompanyInvite(companyId) {
      return get(/databases/$(database)/documents/businesses/$(companyId)/invites/$(authEmailLower()));
    }

    function hasPendingCompanyInvite(companyId) {
      return isSignedIn() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/businesses/$(companyId)/invites/$(authEmailLower())) &&
        ownCompanyInvite(companyId).data.status == 'pending';
    }

    function globalInvitePath() {
      return /databases/$(database)/documents/invites/$(authEmailLower());
    }

    function hasGlobalPendingInvite() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        exists(globalInvitePath()) &&
        get(globalInvitePath()).data.status == 'pending';
    }

    function globalInviteCompany() {
      return get(globalInvitePath()).data.companyId;
    }

    function hasPendingInviteFor(companyId) {
      return hasPendingCompanyInvite(companyId) ||
        (hasGlobalPendingInvite() && globalInviteCompany() == companyId);
    }

    function isVoidingUnchanged() {
      return request.resource.data.get('isVoided', false) == resource.data.get('isVoided', false);
    }

    function isFiniteNumber(value) {
      return value is number && value == value;
    }

    function isNonNegNumber(value) {
      return isFiniteNumber(value) && value >= 0;
    }

    function isPositiveNumber(value) {
      return isFiniteNumber(value) && value > 0;
    }

    function validInviteRole(value) {
      return value in ['staff', 'ca', 'company_admin'];
    }

    function validMemberRole(value) {
      return value in ['owner', 'company_admin', 'staff', 'ca'];
    }

    function tenantFieldOk(companyId) {
      return request.resource.data.get('companyId', companyId) == companyId;
    }

    function isDesignatedMasterEmail() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        authEmailLower() == 'imhelipatel12@gmail.com';
    }

    function canBootstrapMaster() {
      return isSignedIn() && isDesignatedMasterEmail();
    }

    match /platform/state {
      allow get: if isSignedIn();
      allow create: if canBootstrapMaster() &&
        request.resource.data.masterAdminUid == request.auth.uid;
      allow update, delete: if isMasterAdmin() || (
        canBootstrapMaster() &&
        request.resource.data.masterAdminUid == request.auth.uid
      );
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isMasterAdmin());
      allow list: if isMasterAdmin();
      allow create: if request.auth.uid == userId && (
        (
          canBootstrapMaster() &&
          request.resource.data.role == 'master_admin' &&
          request.resource.data.email == authEmailLower()
        ) ||
        (
          isEmailVerified() &&
          hasGlobalPendingInvite() &&
          validMemberRole(request.resource.data.role) &&
          request.resource.data.role == get(globalInvitePath()).data.role &&
          request.resource.data.companyId == globalInviteCompany() &&
          request.resource.data.email == authEmailLower()
        ) ||
        (
          isEmailVerified() &&
          request.resource.data.companyId is string &&
          isMember(request.resource.data.companyId) &&
          request.resource.data.email == authEmailLower() &&
          validMemberRole(request.resource.data.role)
        )
      );
      allow update: if (
          isMasterAdmin() &&
          request.resource.data.email == resource.data.email
        ) ||
        (
          canBootstrapMaster() &&
          request.auth.uid == userId &&
          request.resource.data.role == 'master_admin' &&
          request.resource.data.email == authEmailLower()
        ) ||
        (
          isSignedIn() &&
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.get('companyId', null) == resource.data.get('companyId', null) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'gender', 'birthday', 'email', 'location', 'phone'])
        );
      allow delete: if isMasterAdmin() ||
        (
          resource.data.companyId is string &&
          isCompanyAdmin(resource.data.companyId) &&
          resource.data.role in ['staff', 'ca']
        );
    }

    match /invites/{inviteId} {
      allow get: if isSignedIn() && (
        (request.auth.token.email != null && authEmailLower() == inviteId) ||
        isMasterAdmin() ||
        (resource.data.companyId is string && isCompanyAdmin(resource.data.companyId))
      );
      allow list: if isMasterAdmin();
      allow create: if isEmailVerified() &&
        request.resource.data.email == inviteId &&
        inviteId == inviteId.lower() &&
        validInviteRole(request.resource.data.role) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.companyId is string &&
        (
          isMasterAdmin() ||
          (
            isCompanyAdmin(request.resource.data.companyId) &&
            request.resource.data.role in ['staff', 'ca'] &&
            companyActive(request.resource.data.companyId)
          )
        );
      allow delete: if isMasterAdmin() ||
        (request.auth.token.email != null && authEmailLower() == inviteId) ||
        (resource.data.companyId is string && isCompanyAdmin(resource.data.companyId));
      allow update: if isMasterAdmin() ||
        (isEmailVerified() &&
          request.auth.token.email != null &&
          authEmailLower() == inviteId &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.companyId == resource.data.companyId &&
          validInviteRole(resource.data.role) &&
          request.resource.data.email == resource.data.email) ||
        (resource.data.companyId is string && isCompanyAdmin(resource.data.companyId));
    }

    match /businesses/{businessId} {
      allow get: if isMasterAdmin() ||
        (isMember(businessId) && companyNotDeleted(businessId)) ||
        hasPendingInviteFor(businessId) ||
        (isSignedIn() && !companyExists(businessId));
      allow list: if isMasterAdmin();
      allow create: if isMasterAdmin() &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.status == 'active' &&
        request.resource.data.name is string &&
        request.resource.data.get('companyId', businessId) == businessId;
      allow update: if isMasterAdmin() ||
        (
          isCompanyAdmin(businessId) &&
          companyActive(businessId) &&
          request.resource.data.createdByUid == resource.data.createdByUid &&
          request.resource.data.get('status', 'active') == resource.data.get('status', 'active')
        );
      allow delete: if isMasterAdmin();

      match /users/{userId} {
        allow get: if isSignedIn() && (
          request.auth.uid == userId ||
          isMember(businessId) ||
          isMasterAdmin()
        );
        allow list: if isCompanyAdmin(businessId);
        allow update: if (
            isMasterAdmin() &&
            validMemberRole(request.resource.data.role)
          ) ||
          (
            isCompanyAdmin(businessId) &&
            companyActive(businessId) &&
            validMemberRole(request.resource.data.role) &&
            resource.data.role in ['staff', 'ca'] &&
            request.resource.data.role in ['staff', 'ca']
          ) ||
          (
            isSignedIn() &&
            request.auth.uid == userId &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'gender', 'birthday', 'email', 'location', 'phone', 'companyId'])
          );
        allow delete: if isCompanyAdmin(businessId);
        allow create: if isMasterAdmin() ||
          (
            isEmailVerified() &&
            request.auth.uid == userId &&
            companyExists(businessId) &&
            hasPendingInviteFor(businessId) &&
            validMemberRole(request.resource.data.role) &&
            request.resource.data.email == authEmailLower() &&
            tenantFieldOk(businessId) &&
            (
              (
                hasGlobalPendingInvite() &&
                globalInviteCompany() == businessId &&
                request.resource.data.role == get(globalInvitePath()).data.role
              ) ||
              (
                hasPendingCompanyInvite(businessId) &&
                request.resource.data.role == ownCompanyInvite(businessId).data.role
              )
            )
          );
      }

      match /invites/{inviteId} {
        allow get: if isSignedIn() &&
          request.auth.token.email != null &&
          authEmailLower() == inviteId;
        allow list: if isCompanyAdmin(businessId);
        allow create: if (
            isMasterAdmin() ||
            (isCompanyAdmin(businessId) && companyActive(businessId))
          ) &&
          validInviteRole(request.resource.data.role) &&
          (
            isMasterAdmin() ||
            request.resource.data.role in ['staff', 'ca']
          ) &&
          request.resource.data.email == inviteId &&
          inviteId == inviteId.lower() &&
          request.resource.data.get('companyId', businessId) == businessId;
        allow delete: if isCompanyAdmin(businessId);
        allow update: if isCompanyAdmin(businessId) ||
          (isEmailVerified() &&
            request.auth.token.email != null &&
            authEmailLower() == inviteId &&
            resource.data.status == 'pending' &&
            request.resource.data.status == 'accepted' &&
            request.resource.data.role == resource.data.role &&
            validInviteRole(resource.data.role) &&
            request.resource.data.email == resource.data.email);
      }

      match /veparis/{vepariId} {
        allow read: if (isMember(businessId) && companyNotDeleted(businessId)) || isMasterAdmin();
        allow create, update: if isCompanyAdmin(businessId) && companyActive(businessId) &&
          tenantFieldOk(businessId);
        allow delete: if isCompanyAdmin(businessId) && companyActive(businessId);
      }

      match /bills/{billId} {
        allow read: if (isMember(businessId) && companyNotDeleted(businessId)) || isMasterAdmin();
        allow create: if isStaffOrOwner(businessId) && companyActive(businessId) &&
          isNonNegNumber(request.resource.data.totalAmount) &&
          request.resource.data.date is string &&
          request.resource.data.items is list &&
          request.resource.data.keys().hasAll(['date', 'totalAmount', 'items']) &&
          request.resource.data.get('isVoided', false) == false &&
          tenantFieldOk(businessId);
        allow update: if isStaffOrOwner(businessId) && companyActive(businessId) &&
          (isVoidingUnchanged() || isCompanyAdmin(businessId)) &&
          isNonNegNumber(request.resource.data.totalAmount) &&
          request.resource.data.date is string &&
          request.resource.data.items is list &&
          tenantFieldOk(businessId) &&
          (
            !('entryNumber' in resource.data) ||
            resource.data.entryNumber == null ||
            request.resource.data.entryNumber == resource.data.entryNumber ||
            isCompanyAdmin(businessId)
          ) &&
          (
            !('dakhlaNumber' in resource.data) ||
            resource.data.dakhlaNumber == null ||
            request.resource.data.dakhlaNumber == resource.data.dakhlaNumber ||
            isCompanyAdmin(businessId)
          );
        allow delete: if false;
      }

      match /payments/{paymentId} {
        allow read: if (isMember(businessId) && companyNotDeleted(businessId)) || isMasterAdmin();
        allow create: if isStaffOrOwner(businessId) && companyActive(businessId) &&
          isPositiveNumber(request.resource.data.amount) &&
          request.resource.data.billId is string &&
          request.resource.data.date is string &&
          request.resource.data.get('isVoided', false) == false &&
          tenantFieldOk(businessId);
        allow update: if isStaffOrOwner(businessId) && companyActive(businessId) &&
          (isVoidingUnchanged() || isCompanyAdmin(businessId)) &&
          isPositiveNumber(request.resource.data.amount) &&
          request.resource.data.billId == resource.data.billId &&
          request.resource.data.date is string &&
          tenantFieldOk(businessId);
        allow delete: if false;
      }

      match /vepariPayments/{paymentId} {
        allow read: if (isMember(businessId) && companyNotDeleted(businessId)) || isMasterAdmin();
        allow create: if isStaffOrOwner(businessId) && companyActive(businessId) &&
          isPositiveNumber(request.resource.data.amount) &&
          request.resource.data.billId is string &&
          request.resource.data.date is string &&
          request.resource.data.get('isVoided', false) == false &&
          tenantFieldOk(businessId);
        allow update: if isStaffOrOwner(businessId) && companyActive(businessId) &&
          (isVoidingUnchanged() || isCompanyAdmin(businessId)) &&
          isPositiveNumber(request.resource.data.amount) &&
          request.resource.data.billId == resource.data.billId &&
          request.resource.data.date is string &&
          tenantFieldOk(businessId);
        allow delete: if false;
      }

      match /counters/{counterId} {
        allow read: if (isMember(businessId) && companyNotDeleted(businessId)) || isMasterAdmin();
        allow create, update: if isStaffOrOwner(businessId) && companyActive(businessId) &&
          counterId in ['entryNumber', 'dakhlaNumber'] &&
          request.resource.data.keys().hasAll(['next']) &&
          isPositiveNumber(request.resource.data.next) &&
          tenantFieldOk(businessId);
        allow delete: if false;
      }

      match /silakEntries/{entryId} {
        allow read: if (isMember(businessId) && companyNotDeleted(businessId)) || isMasterAdmin();
        allow create: if isStaffOrOwner(businessId) && companyActive(businessId) &&
          request.resource.data.isManual == true &&
          isPositiveNumber(request.resource.data.amount) &&
          request.resource.data.side in ['jama', 'udhar'] &&
          request.resource.data.date is string &&
          tenantFieldOk(businessId);
        allow update: if isStaffOrOwner(businessId) && companyActive(businessId) &&
          resource.data.isManual == true &&
          request.resource.data.isManual == true &&
          isPositiveNumber(request.resource.data.amount) &&
          request.resource.data.side in ['jama', 'udhar'] &&
          tenantFieldOk(businessId);
        allow delete: if isCompanyAdmin(businessId) &&
          resource.data.isManual == true;
      }
    }
  }
}
