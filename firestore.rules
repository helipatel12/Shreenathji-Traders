// Firestore security rules — Shreenath Traders (single-business deploy).
// Deployed with the Gujarati/English i18n + CA read-only hardening pass.
//
// - Members only read/write inside their business
// - owner: full access including settings/users/void
// - staff: bills, payments, silak (manual); no settings/rates/users
// - ca: read-only everywhere
// - Bootstrap: first signed-in user may create the business + own owner
//   user doc only while the business does not exist yet
// - Invites: invitee may create their own users/{uid} with the invited role

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)/users/$(request.auth.uid));
    }

    function role(businessId) {
      return userDoc(businessId).data.role;
    }

    function isMember(businessId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/businesses/$(businessId)/users/$(request.auth.uid));
    }

    function isOwner(businessId) {
      return isMember(businessId) && role(businessId) == 'owner';
    }

    function isStaffOrOwner(businessId) {
      return isMember(businessId) && role(businessId) in ['owner', 'staff'];
    }

    function businessExists(businessId) {
      return exists(/databases/$(database)/documents/businesses/$(businessId));
    }

    function ownInvite(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)/invites/$(request.auth.token.email.lower()));
    }

    function hasPendingInvite(businessId) {
      return isSignedIn() &&
        request.auth.token.email != null &&
        exists(/databases/$(database)/documents/businesses/$(businessId)/invites/$(request.auth.token.email.lower())) &&
        ownInvite(businessId).data.status == 'pending';
    }

    function isVoidingUnchanged() {
      return request.resource.data.get('isVoided', false) == resource.data.get('isVoided', false);
    }

    match /businesses/{businessId} {
      // Members may read the business profile. Non-members may only
      // `get` when the business does not exist yet (bootstrap probe),
      // or when they have a pending invite (so invite acceptance can
      // confirm the business before creating their user doc).
      allow get: if isMember(businessId) ||
        (isSignedIn() && !businessExists(businessId)) ||
        hasPendingInvite(businessId);
      allow list: if false;
      allow update, delete: if isOwner(businessId);
      allow create: if isSignedIn() && !businessExists(businessId);

      match /users/{userId} {
        allow get: if isSignedIn() && (request.auth.uid == userId || isMember(businessId));
        allow list: if isMember(businessId);
        // Owner can edit anyone; a member can edit only their own
        // profile fields (name/gender/birthday/email) — never their role.
        allow update: if isOwner(businessId) ||
          (isSignedIn() &&
            request.auth.uid == userId &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'gender', 'birthday', 'email']));
        allow delete: if isOwner(businessId);
        allow create: if isOwner(businessId) ||
          (isSignedIn() &&
            request.auth.uid == userId &&
            !businessExists(businessId) &&
            request.resource.data.role == 'owner' &&
            request.resource.data.keys().hasAll(['email', 'role']) &&
            request.resource.data.email == request.auth.token.email) ||
          (isSignedIn() &&
            request.auth.uid == userId &&
            businessExists(businessId) &&
            hasPendingInvite(businessId) &&
            request.resource.data.role == ownInvite(businessId).data.role &&
            request.resource.data.email == request.auth.token.email);
      }

      match /invites/{inviteId} {
        allow get: if isSignedIn() &&
          request.auth.token.email != null &&
          request.auth.token.email.lower() == inviteId;
        allow list: if isOwner(businessId);
        allow create, delete: if isOwner(businessId);
        allow update: if isOwner(businessId) ||
          (isSignedIn() &&
            request.auth.token.email != null &&
            request.auth.token.email.lower() == inviteId &&
            resource.data.status == 'pending' &&
            request.resource.data.status == 'accepted' &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.email == resource.data.email);
      }

      match /veparis/{vepariId} {
        allow read: if isMember(businessId);
        allow write: if isOwner(businessId);
      }

      match /bills/{billId} {
        allow read: if isMember(businessId);
        allow create: if isStaffOrOwner(businessId);
        allow update: if isStaffOrOwner(businessId) &&
          (isVoidingUnchanged() || isOwner(businessId));
        allow delete: if false;
      }

      match /payments/{paymentId} {
        allow read: if isMember(businessId);
        allow create: if isStaffOrOwner(businessId);
        allow update: if isStaffOrOwner(businessId) &&
          (isVoidingUnchanged() || isOwner(businessId));
        allow delete: if false;
      }

      match /silakEntries/{entryId} {
        allow read: if isMember(businessId);
        allow create: if isStaffOrOwner(businessId) &&
          request.resource.data.isManual == true;
        allow update, delete: if isStaffOrOwner(businessId) &&
          resource.data.isManual == true;
      }
    }
  }
}
