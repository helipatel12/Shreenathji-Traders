// DRAFT — Firebase Storage security rules (bill photos).
// Same review requirement as firestore.rules — see the note there.
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /businesses/{businessId}/bills/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/businesses/$(businessId)/users/$(request.auth.uid));
    }
  }
}
